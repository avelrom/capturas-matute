---
import { isOff } from '@fediblog/core/lib/flags';
import '@fediblog/core/styles/fonts.css';
import { SITE } from '../config';
import { actor } from '../lib/actor';
import SearchDialog from '@fediblog/core/components/SearchDialog.astro';
import Lightbox from '../components/Lightbox.astro';
import RssCopy from '@fediblog/core/components/RssCopy.astro';
import ThemeToggle from '@fediblog/core/components/ThemeToggle.astro';
import { socialItems } from '@fediblog/core/lib/social';
import Footer from '@fediblog/core/components/Footer.astro';
import ViewSizeDock, { type ViewOption } from '@fediblog/core/components/ViewSizeDock.astro';
import ConfigFields from '@fediblog/core/components/ConfigFields.astro';
import ThemeFontSizes from '@fediblog/core/components/ThemeFontSizes.astro';
import { fontSizeAttrs } from '@fediblog/core/lib/font-sizes';
import ThemeColors from '@fediblog/core/components/ThemeColors.astro';
import PreviewSidebar from '@fediblog/core/components/PreviewSidebar.astro';
import configSource from '../config.ts?raw';
import { Search } from '@lucide/astro';
import Icon from '@fediblog/core/components/Icon.astro';
import { menuItem } from '@fediblog/core/lib/menu';
import { resolveSizes, resolveViews } from '@fediblog/core/lib/view-size';

interface Props {
  title?: string;
  description?: string;
  isEntry?: boolean;
  /** Página de una entrada: solo ahí el título de la pestaña lleva el de la entrada. */
  isPost?: boolean;
  /** Ancho mayor (64rem) — para el editor incrustado o vistas amplias. */
  wide?: boolean;
  /** Indica si es la galería principal para permitir el ancho extendido en vista de filas. */
  isGallery?: boolean;
}

const { title, description = actor.summaryText, isEntry = false, isPost = false, wide = false, isGallery = false } = Astro.props;
const pageTitle = isPost && title ? `${title} — ${SITE.site.title}` : SITE.site.title;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const VIEW_OPTIONS: [string, string][] = [['grid', 'Cuadrícula'], ['rows', 'En fila']];
const ALL_VIEWS: ViewOption[] = [          {
            id: 'grid',
            label: 'Vista en cuadrícula',
            iconSvg: '<svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect></svg>',
          },
          {
            id: 'rows',
            label: 'Vista en fila',
            iconSvg: '<svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"></rect><line x1="3" x2="21" y1="9" y2="9"></line><line x1="3" x2="21" y1="15" y2="15"></line></svg>',
          },
];
const { sizes, defaultSize } = resolveSizes(SITE.gallery.sizes, SITE.gallery.defaultSize);
const { views: enabledViews, defaultView } = resolveViews(['grid', 'rows'] as const, SITE.gallery.views, SITE.gallery.defaultView);
const about = menuItem(SITE.site.menu, 'about', { label: 'Acerca de', icon: 'user' });
const archive = menuItem(SITE.site.menu, 'archive', { label: 'Archivo', icon: 'archive' });
const rss = menuItem(SITE.site.menu, 'rss', { label: 'RSS', icon: 'rss' });
const pathname = Astro.url.pathname;
const isAbout = pathname.endsWith('/about') || pathname.endsWith('/about/');
const isArchive = pathname.endsWith('/archivo') || pathname.endsWith('/archivo/');

const socialLinks = socialItems(SITE.social);

const showPreviewSidebar =
  SITE.site.previewSidebar || import.meta.env.PUBLIC_FB_LIVE_PREVIEW === '1';

const menuStyle = (SITE as any).site.menuStyle || 'icons';
---

<!doctype html>
<html {...fontSizeAttrs(SITE.site.fontSize)} lang={SITE.site.locale} data-font={SITE.site.font} data-layout={defaultView} data-size={defaultSize} data-menu-style={menuStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site || 'https://ejemplo.com')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.site.title} href={`${base}rss.xml`} />
    <link rel="alternate" type="application/feed+json" title={`${SITE.site.title} (JSON Feed)`} href={`${base}feed.json`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg?v=2`} />
    <meta name="generator" content={Astro.generator} />

    <script is:inline define:vars={{ darkMode: SITE.site.darkMode, views: enabledViews, sizes, defaultSize }}>
      (function () {
        try {
          var stored = darkMode === 'light' || darkMode === 'dark' ? darkMode : darkMode === 'toggle' ? localStorage.getItem('fb-theme') : null;
          var darkPref = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored || (darkPref ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);

          var params = new URLSearchParams(window.location.search);
          var viewParam = params.get('view');
          var storedLayout = viewParam || localStorage.getItem('weiss-view');
          if (storedLayout && views.indexOf(storedLayout) >= 0) {
            document.documentElement.setAttribute('data-layout', storedLayout);
            document.documentElement.setAttribute('data-view', storedLayout);
          }

          var sizeParam = params.get('size');
          var storedSize = sizeParam || localStorage.getItem('weiss-size');
          if (storedSize && sizes.indexOf(storedSize) >= 0) {
            document.documentElement.setAttribute('data-size', storedSize);
          }

          var menuParam = params.get('menu') || params.get('menu-style');
          var storedMenu = menuParam || localStorage.getItem('weiss-menu');
          if (storedMenu === 'icons' || storedMenu === 'text') {
            document.documentElement.setAttribute('data-menu-style', storedMenu);
          }
        } catch (e) {}
      })();
    </script>
    <ThemeColors colors={SITE.site.colors} vars={{ accent: ['--accent', '--accent-hover'], title: ['--title-color'] }} titleSelectors={['.brand', '.brand-text', '.entry-title', '.tag-title']} titleFallback="var(--fg)" />
    <ThemeFontSizes selectors={{ brand: ['.brand'], title: ['.feed .entry-title', '.tag-title'], postTitle: ['.entry-page .entry-title'], body: ['.body', '.entry-text-link'] }} />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>

    <header class="site-header">
      <div class="header-top">
        <div class="site-nav-group">
          <nav class="site-nav" aria-label="Navegación principal">
            {!isOff(SITE.profile?.show) && (
            <a
              href={`${base}about/`}
              class:list={[isAbout && 'active']}
              aria-label="Acerca de"
              title="Acerca de"
              aria-current={isAbout ? 'page' : undefined}
            >
              {about.icon && <Icon name={about.icon} size={15} class="nav-icon" />}
              <span class="nav-text" data-preview-field="site.menu.about.label" data-preview-type="text" data-preview-label="«Acerca de»: texto del enlace" data-preview-group="Menú">{about.label}</span>
            </a>
            )}
            {!isOff(SITE.archive?.show) && (
              <a
                href={`${base}archivo/`}
                class:list={[isArchive && 'active']}
                data-preview-field="archive.show"
                data-preview-label="Enlace al archivo"
                data-preview-group="Archivo"
                aria-label="Archivo"
                title="Archivo"
                aria-current={isArchive ? 'page' : undefined}
              >
                {archive.icon && <Icon name={archive.icon} size={15} class="nav-icon" />}
                <span class="nav-text" data-preview-field="site.menu.archive.label" data-preview-type="text" data-preview-label="«Archivo»: texto del enlace" data-preview-group="Menú">{archive.label}</span>
              </a>
            )}
            <button type="button" class="nav-btn nav-btn-rss" data-copy-rss={`${base}rss.xml`} aria-label="Copiar feed RSS" title="Copiar feed RSS">
              {rss.icon && <Icon name={rss.icon} size={15} class="nav-icon" />}
              <span class="nav-text" data-preview-field="site.menu.rss.label" data-preview-type="text" data-preview-label="«RSS»: texto del enlace" data-preview-group="Menú">{rss.label}</span>
            </button>
            <button type="button" class="nav-btn" data-search-open hidden aria-label="Buscar" title="Buscar (/ o ⌘K)">
              <Search size={15} stroke-width={1.8} class="nav-icon" aria-hidden="true" />
              <span class="nav-text">Buscar</span>
            </button>
            {SITE.site.darkMode === 'toggle' && <ThemeToggle class="nav-btn" />}
          </nav>

          {socialLinks.length > 0 && (
            <div class="site-tools">
              <nav class="social-nav" aria-label="Redes sociales">
                {socialLinks.map((s) => (
                  <a
                    href={s.url}
                    target="_blank"
                    rel="me noopener noreferrer"
                    aria-label={s.label}
                    title={s.label}
                    data-preview-field={`social.${s.key}`}
                    data-preview-type="text"
                    data-preview-apply="hide-if-empty"
                    data-preview-panel="false"
                  >
                    <svg
                      class="nav-icon"
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={s.innerHtml}
                    />
                    <span class="nav-text">{s.label}</span>
                  </a>
                ))}
              </nav>
            </div>
          )}
        </div>
      </div>

      <div class="header-center">
        <a
          href={base}
          class="brand"
          data-preview-field="site.title"
          data-preview-type="text"
          data-preview-label="Título del sitio"
          data-preview-group="Cabecera"
          data-preview-sync-title="true"
        >
          <span class="brand-text">{SITE.site.title}</span>
        </a>
      </div>

      <!-- Instrumentación de campos de configuración sin vista previa directa -->
      <Fragment>
        <span
          hidden
          data-preview-field="gallery.defaultView"
          data-preview-type="select"
          data-preview-apply="root-attr:data-layout"
          data-preview-label="Vista por defecto"
          data-preview-group="Galería"
          data-preview-options={JSON.stringify([['grid', 'Cuadrícula (Grid)'], ['rows', 'Vista en fila (Filas)']])}
        ></span>
        <span
          hidden
          data-preview-field="gallery.defaultSize"
          data-preview-type="select"
          data-preview-apply="root-attr:data-size"
          data-preview-label="Tamaño por defecto"
          data-preview-group="Galería"
          data-preview-options={JSON.stringify([['sm', 'Pequeño (S)'], ['md', 'Medio (M)'], ['lg', 'Grande (L)']])}
        ></span>
      </Fragment>
    </header>

    <main id="main" tabindex="-1" class:list={[wide && 'wide', isGallery && 'is-gallery']}>
      {!isEntry && <h1 class="sr-only">{SITE.site.title}</h1>}
      <slot />
    </main>

    {isGallery && (
      <ViewSizeDock
                views={ALL_VIEWS.filter((v) => enabledViews.includes(v.id as any))}
        activeView={defaultView}
        sizes={sizes}
        activeSize={defaultSize}
        themeId="weiss"
      />
    )}

    <Footer authorName={actor.name} siteTitle={SITE.site.title} base={base} />

    <Lightbox />
    <SearchDialog />
    <RssCopy />

    {showPreviewSidebar && <><PreviewSidebar siteConfig={SITE} configSource={configSource} themeId="weiss" /><ConfigFields fieldOptions={{ 'gallery.views': VIEW_OPTIONS, 'gallery.defaultView': VIEW_OPTIONS }} siteConfig={SITE} colorVars={{ accent: ['--accent', '--accent-hover'], title: ['--title-color'] }} titleSample=".brand" /></>}
  </body>
</html>


<style is:global>
  :root[data-font='serif'] {
    --sans: 'Newsreader Variable', 'Iowan Old Style', Charter, 'Bitstream Charter', Georgia, serif;
  }
  :root[data-font='mono'] {
    --sans: var(--mono);
  }

  :root {
    --bg: #ffffff;
    --bg-subtle: #fafafa;
    --surface: #f4f4f5;
    --surface-hover: #ececee;
    --fg: #111113;
    --fg-secondary: #4b4b53;
    --fg-muted: #71717a;
    --fg-subtle: #a1a1aa;
    --line: #e4e4e7;
    --line-subtle: #f0f0f3;
    --line-strong: #d4d4d8;
    --accent: #111113;
    --accent-hover: #27272a;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
    --radius-full: 9999px;
    --sans: 'Inter Variable', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --mono: 'Commit Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    --transition: 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0c0c0e;
      --bg-subtle: #121215;
      --surface: #18181c;
      --surface-hover: #232328;
      --fg: #f4f4f6;
      --fg-secondary: #c4c4cc;
      --fg-muted: #91919c;
      --fg-subtle: #6b6b77;
      --line: #222228;
      --line-subtle: #18181c;
      --line-strong: #333338;
      --accent: #f4f4f6;
      --accent-hover: #e4e4e8;
    }
  }

  :root[data-theme="dark"] {
    --bg: #0c0c0e;
    --bg-subtle: #121215;
    --surface: #18181c;
    --surface-hover: #232328;
    --fg: #f4f4f6;
    --fg-secondary: #c4c4cc;
    --fg-muted: #91919c;
    --fg-subtle: #6b6b77;
    --line: #222228;
    --line-subtle: #18181c;
    --line-strong: #333338;
    --accent: #f4f4f6;
    --accent-hover: #e4e4e8;
  }

  :root[data-theme="light"] {
    --bg: #ffffff;
    --bg-subtle: #fafafa;
    --surface: #f4f4f5;
    --surface-hover: #ececee;
    --fg: #111113;
    --fg-secondary: #4b4b53;
    --fg-muted: #71717a;
    --fg-subtle: #a1a1aa;
    --line: #e4e4e7;
    --line-subtle: #f0f0f3;
    --line-strong: #d4d4d8;
    --accent: #111113;
    --accent-hover: #27272a;
  }

  /* Comentarios: paleta y acabado limpio, sin bordes superiores */
  .comments {
    --cm-fg: var(--fg);
    --cm-muted: var(--fg-muted);
    --cm-line: var(--line-subtle);
    --cm-accent: var(--fg);
    --cm-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-family: var(--sans);
    margin-top: 2.5rem;
    padding-top: 0;
    border: none !important;
    border-top: none !important;
  }

  .comments-title {
    font-size: 0.76rem;
    font-weight: 500;
    color: var(--fg-muted);
    font-family: var(--sans);
    text-transform: none;
    letter-spacing: normal;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .comments-title a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--line);
    transition: color var(--transition), text-decoration-color var(--transition);
  }
  .comments-title a:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  .comments .comment-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .comments .comment-body {
    font-size: 0.835rem;
    line-height: 1.58;
    color: var(--fg-secondary);
    margin-top: 0.4rem;
  }

  .comments .comment-author {
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--fg);
  }

  .comments .comment-handle {
    font-size: 0.72rem;
    font-family: var(--mono);
    color: var(--fg-muted);
  }

  .comments .comment-date {
    font-size: 0.72rem;
    font-family: var(--mono);
    color: var(--fg-subtle);
  }

  .comments .comment-avatar {
    border-radius: var(--radius-full);
  }

  .comments--empty {
    margin-top: 2rem;
    padding-top: 0;
    border: none;
    display: flex;
    justify-content: center;
  }

  .comments-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 1.15rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--line);
    background: transparent;
    color: var(--fg-secondary);
    font-size: 0.78rem;
    font-weight: 500;
    font-family: var(--sans);
    text-decoration: none;
    transition: all var(--transition);
  }

  .comments-link::after {
    content: "↗";
    font-size: 0.72rem;
    color: var(--fg-subtle);
    transition: transform var(--transition), color var(--transition);
  }

  .comments-link:hover {
    border-color: var(--fg-muted);
    background: var(--surface);
  }

  .comments-link:hover::before {
    color: var(--fg);
  }

  .comments-link:hover::after {
    color: var(--fg);
    transform: translate(1px, -1px);
  }

  * {
    box-sizing: border-box;
    margin: 0;
  }

  html {
    color-scheme: light dark;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--sans);
    font-size: 0.9375rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  :focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  main:focus {
    outline: none;
  }

  .skip-link {
    position: fixed;
    top: -4rem;
    left: 1.5rem;
    z-index: 100;
    background: var(--fg);
    color: var(--bg);
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: top 0.2s ease;
  }
  .skip-link:focus,
  .skip-link:focus-visible {
    top: 1.5rem;
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Cabecera con menú arriba a la derecha y título centrado con peso */
  /* Cabecera con menú arriba a la derecha y título centrado con peso */
  .site-header {
    width: 100%;
    padding: 1.75rem 0 2.25rem;
    position: relative;
  }

  .header-top {
    width: 100%;
    max-width: 64rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    box-sizing: border-box;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .site-nav-group {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 450;
    line-height: 1;
    flex-wrap: wrap;
  }

  .site-tools {
    display: inline-flex;
    align-items: center;
    padding-left: 0.75rem;
    border-left: 1px solid var(--line);
  }

  .social-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    line-height: 1;
  }

  .header-center {
    width: 100%;
    max-width: 44rem;
    margin: 1.15rem auto 0;
    padding: 0 1.5rem;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--fg);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.25;
    transition: opacity var(--transition);
  }
  .brand:hover {
    opacity: 0.7;
  }

  .brand-text {
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    line-height: inherit;
    color: inherit;
  }

  @media (max-width: 44rem) {
    .site-header {
      padding: 1.5rem 0 1.75rem;
    }
    .header-top {
      justify-content: center;
    }
    .site-nav-group {
      justify-content: center;
      gap: 0.55rem;
    }
    .site-tools {
      padding-left: 0.55rem;
    }
    .site-header nav {
      justify-content: center;
      gap: 0.35rem;
    }
    .header-center {
      margin-top: 1rem;
    }
    .brand,
    .brand-text {
      font-size: 1.25rem;
    }
  }

  .site-header nav a,
  .site-header nav .nav-btn {
    text-decoration: none;
    color: var(--fg-muted);
    transition: color 0.15s ease, background-color 0.15s ease;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: transparent;
    border: none;
    margin: 0;
    font: inherit;
    cursor: pointer;
  }
  .site-header nav a:hover,
  .site-header nav a.active,
  .site-header nav .nav-btn:hover,
  .site-header nav .nav-btn.active {
    color: var(--fg);
    background-color: var(--line);
  }

  .site-header nav .nav-btn.is-copied {
    color: var(--fg);
    background-color: var(--line);
  }

  /* Modo por defecto: 100% ICONOS (nunca mezcla texto) */
  :root:not([data-menu-style="text"]) .site-header nav a,
  :root:not([data-menu-style="text"]) .site-header nav .nav-btn,
  :root[data-menu-style="icons"] .site-header nav a,
  :root[data-menu-style="icons"] .site-header nav .nav-btn {
    width: 1.65rem;
    height: 1.65rem;
    padding: 0;
  }

  :root:not([data-menu-style="text"]) .site-header nav a:has(.nav-icon) .nav-text,
