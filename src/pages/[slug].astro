---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getNotas } from '@fediblog/core/lib/notas';
import ContentWarning from '@fediblog/core/components/ContentWarning.astro';
import Engagement from '@fediblog/core/components/Engagement.astro';
import Comments from '@fediblog/core/components/Comments.astro';
import { SITE } from '../config';
import { formatDate, isStandaloneTitleParagraph } from '@fediblog/core/lib/format';
import { slugify } from '@fediblog/core/lib/slug';

export async function getStaticPaths() {
  const notas = await getNotas();
  return notas.map((nota) => ({ params: { slug: nota.id }, props: { nota } }));
}

const { nota } = Astro.props;
const { Content } = await render(nota);
const base = import.meta.env.BASE_URL;
const images = nota.data.images;
const dateFormatted = formatDate(nota.data.date, 'dd/mm/yyyy');

const postComments = nota.data.comments ?? [];
const commentCount = nota.data.commentCount ?? 0;

function splitLeadTitleFromHtml(html: string): { title: string | null; bodyHtml: string } {
  const brMatch = html.match(/^\s*<p>([\s\S]*?)(?:<br\s*\/?>\s*){2,}([\s\S]*?)<\/p>/i);
  if (brMatch) {
    const rawFirst = brMatch[1].replace(/<[^>]+>/g, '').trim();
    if (isStandaloneTitleParagraph(rawFirst)) {
      const rest = `<p>${brMatch[2].trim()}</p>` + html.slice(brMatch[0].length);
      return { title: rawFirst, bodyHtml: rest };
    }
  }
  const pMatch = html.match(/^\s*<p>([\s\S]*?)<\/p>/i);
  if (pMatch) {
    const rawFirst = pMatch[1].replace(/<[^>]+>/g, '').trim();
    const rest = html.slice(pMatch[0].length).trim();
    if (rest && isStandaloneTitleParagraph(rawFirst)) {
      return { title: rawFirst, bodyHtml: rest };
    }
  }
  return { title: null, bodyHtml: html };
}

const rawHtml = nota.rendered?.html ?? '';
const { title: leadTitle, bodyHtml } = splitLeadTitleFromHtml(rawHtml);
---

<Base title={leadTitle || nota.data.title} description={nota.data.excerpt.slice(0, 200)} isEntry isPost>
  <article class="entry-page">
    <nav class="entry-nav">
      <a href={base} class="back-link">
        <span class="arrow" aria-hidden="true">←</span>
        <span>Volver</span>
      </a>
      <span class="nav-sep" aria-hidden="true">·</span>
      <a class="entry-source" href={nota.data.sourceUrl} target="_blank" rel="noopener noreferrer" title="Ver en el fediverso">
        <time datetime={nota.data.date.toISOString()}>{dateFormatted}</time>
      </a>
    </nav>

    {images.length > 0 && (
      <div class:list={['shots', images.length > 1 && 'is-grid', nota.data.sensitive && 'is-sensitive']}>
        {images.map((img: { src: string; alt: string; width?: number; height?: number }) => (
          <div class="shot-wrapper">
            <img
              class="shot"
              src={`${base}${img.src}`}
              alt={img.alt}
              loading="lazy"
              data-lightbox="gallery"
              data-lightbox-src={`${base}${img.src}`}
              data-lightbox-alt={img.alt}
              style={img.width && img.height ? `aspect-ratio: ${img.width} / ${img.height};` : undefined}
            />
          </div>
        ))}
        {nota.data.sensitive && (
          <button type="button" class="reveal-btn" data-reveal>Mostrar contenido sensible</button>
        )}
      </div>
    )}

    <div class="entry-body-wrap">
      {leadTitle ? (
        <h1 class="entry-title">{leadTitle}</h1>
      ) : (
        <h1 class="sr-only">{nota.data.title}</h1>
      )}

      {nota.data.cw ? (
        <ContentWarning cw={nota.data.cw}><div class="body"><Content /></div></ContentWarning>
      ) : (
        <div class="body" set:html={bodyHtml} />
      )}

      {nota.data.tags.length > 0 && (
        <div class="tags">
          {nota.data.tags.map((tag: string) => (
            <a href={`${base}etiquetas/${slugify(tag)}/`}>#{tag}</a>
          ))}
        </div>
      )}

      {SITE.post.showMetrics && (
        <Engagement likes={nota.data.likes} shares={nota.data.shares} sourceUrl={nota.data.sourceUrl} previewHooks data-preview-field="post.showMetrics" data-preview-label="Mostrar «me gusta» y compartidas" data-preview-group="Entrada" />
      )}
    </div>

    {SITE.post.showComments && (
      <div
        class="comments-wrap"
        data-preview-field="post.showComments"
        data-preview-label="Mostrar comentarios"
        data-preview-group="Entrada"
      >
        <Comments comments={postComments} count={commentCount} sourceUrl={nota.data.sourceUrl} avatars={SITE.post.commentAvatars} previewHooks={true} />
      </div>
    )}
  </article>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.shots [data-reveal]').forEach((btn) => {
    btn.addEventListener('click', () => {
      btn.closest('.shots')?.classList.remove('is-sensitive');
    });
  });
</script>

<style>
  .entry-page {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .entry-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 2.25rem;
    font-size: 0.825rem;
    font-family: var(--mono);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--fg-muted);
    transition: color var(--transition);
  }
  .back-link .arrow {
    display: inline-block;
    transition: transform var(--transition);
  }
  .back-link:hover {
    color: var(--fg);
  }
  .back-link:hover .arrow {
    transform: translateX(-3px);
  }

  .nav-sep {
    color: var(--fg-subtle);
  }

  .entry-source {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--fg-muted);
    transition: color var(--transition);
  }
  .entry-source:hover {
    color: var(--fg);
  }

  .shots {
    width: 100%;
    max-width: 44rem;
    margin: 0 auto 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: relative;
    border: none;
    border-radius: 0;
  }

  .shots.is-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .shot-wrapper {
    background: transparent;
    border: none;
    border-radius: 0;
    overflow: hidden;
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .shot {
    width: 100%;
    height: auto;
    min-width: 0;
    max-height: 85vh;
    object-fit: contain;
    display: block;
    border: none;
    border-radius: 0;
    cursor: zoom-in;
    transition: opacity 0.2s ease;
  }
  .shot:hover {
    opacity: 0.95;
  }

  .shots.is-sensitive .shot {
    filter: blur(36px);
    user-select: none;
  }

  .reveal-btn {
    display: none;
  }

  .shots.is-sensitive .reveal-btn {
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    appearance: none;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #ffffff;
    font-family: var(--sans);
    font-size: 0.825rem;
    font-weight: 500;
    padding: 0.65rem 1.25rem;
    border-radius: var(--radius-full);
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    transition: background 0.2s ease, transform 0.15s ease;
  }
  .reveal-btn:hover {
    background: rgba(0, 0, 0, 0.85);
    transform: translate(-50%, -50%) scale(1.02);
  }

  .entry-body-wrap {
    width: 100%;
    max-width: 34rem;
    margin: 0 auto;
  }

  .entry-title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--fg);
    margin: 0 0 1rem;
    text-align: left;
  }


  /* Estilo coherente con la portada: minimalista y limpio, en tamaño cómodo (0.85rem) */
  .body {
    font-size: 0.85rem;
    line-height: 1.62;
    color: var(--fg-secondary);
  }
  .body :global(p) {
    margin: 0 0 1.25rem;
  }
  .body :global(p:last-child) {
    margin-bottom: 0;
  }
  .body :global(a) {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--line-strong);
    transition: text-decoration-color var(--transition);
  }
  .body :global(a:hover) {
    text-decoration-color: var(--fg);
  }
  .body :global(blockquote) {
    margin: 1.25rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--line-strong);
    color: var(--fg-muted);
    font-style: italic;
  }
  .body :global(pre) {
    background: var(--surface);
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1rem;
    overflow-x: auto;
    font-size: 0.75rem;
    font-family: var(--mono);
    margin: 1.25rem 0;
  }
  .body :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
  }

  .tags {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-subtle);
    display: flex;
    justify-content: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .tags a {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-full);
    background: var(--surface);
    color: var(--fg-secondary);
    font-size: 0.72rem;
    font-family: var(--mono);
    text-decoration: none;
    transition: all var(--transition);
  }
  .tags a:hover {
    background: var(--surface-hover);
    color: var(--fg);
  }


  .comments-wrap {
    width: 100%;
    max-width: 34rem;
    margin: 0 auto;
  }
</style>
