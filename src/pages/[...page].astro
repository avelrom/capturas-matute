---
import type { GetStaticPaths } from 'astro';
import Base from '../layouts/Base.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import Pagination from '../components/Pagination.astro';
import { getNotas } from '@fediblog/core/lib/notas';
import { splitLeadTitle } from '@fediblog/core/lib/format';
import { SITE } from '../config';
import { Calendar, Heart, Repeat2, MessageCircle } from '@lucide/astro';

export const getStaticPaths = (async ({ paginate }) => {
  const notas = await getNotas();
  return paginate(notas, { pageSize: SITE.gallery.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const notas = page.data;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

function formatNumericDate(d: Date): string {
  const dd = String(d.getDate()).padStart(2, '0');
  const mm = String(d.getMonth() + 1).padStart(2, '0');
  const yyyy = d.getFullYear();
  return `${dd}/${mm}/${yyyy}`;
}

function extractParagraphs(html?: string, fallback?: string): string[] {
  const raw = html
    ? html
        .replace(/<\/p>/gi, '\n\n')
        .replace(/<br\s*\/?>/gi, '\n')
        .replace(/<[^>]+>/g, '')
        .replace(/&nbsp;/g, ' ')
        .replace(/&amp;/g, '&')
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>')
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g, "'")
    : fallback || '';

  return raw
    .split(/\n\s*\n/)
    .map((p) => p.replace(/\s+/g, ' ').trim())
    .filter(Boolean);
}
---

<Base wide isGallery>
  <ul class="feed">
    {notas.map((nota) => {
      const href = `${base}${nota.id}/`;
      const { date, likes, shares, commentCount, excerpt, cw } = nota.data;
      const dateStr = formatNumericDate(date);

      const paragraphs = cw
        ? [`Aviso: ${cw}`]
        : extractParagraphs(nota.rendered?.html, excerpt);
      const { title: leadTitle, body: bodyParagraphs } = splitLeadTitle(paragraphs);

      return (
        <li class="entry">
          <div class="entry-left">
            <div class="meta meta--hover">
              <time datetime={date.toISOString()} class="meta-date" aria-label={`Publicado el ${dateStr}`}>
                <Calendar size={13} aria-hidden="true" class="icon" />
                <span>{dateStr}</span>
              </time>
              <div class="meta-stats">
                {SITE.post.showMetrics && (
                  <span
                    class="engagement"
                    data-preview-field="post.showMetrics"
                    data-preview-label="«Me gusta» y compartidas (a 0 no se muestran)"
                    data-preview-group="Entrada"
                    style={likes > 0 || shares > 0 ? undefined : 'display:none'}
                    data-preview-fake-wrap="metrics"
                  >
                    <span class="metric-item" data-preview-fake-count style={likes > 0 ? undefined : 'display:none'} aria-label={`${likes} me gusta`}>
                      <Heart size={12} aria-hidden="true" class="icon" />
                      <span data-preview-fake-metric="likes" data-real-count={likes}>{likes}</span>
                    </span>
                    <span class="metric-item" data-preview-fake-count style={shares > 0 ? undefined : 'display:none'} aria-label={`${shares} compartidas`}>
                      <Repeat2 size={13} aria-hidden="true" class="icon" />
                      <span data-preview-fake-metric="shares" data-real-count={shares}>{shares}</span>
                    </span>
                  </span>
                )}
                {SITE.post.showComments && (
                  <span
                    class="metric-item"
                    data-preview-field="post.showComments"
                    data-preview-label="Comentarios al final de cada entrada"
                    data-preview-group="Entrada"
                    aria-label={commentCount > 0 ? `${commentCount} comentarios` : 'Comentarios'}
                  >
                    <MessageCircle size={12} aria-hidden="true" class="icon" />
                    {commentCount > 0 && <span>{commentCount}</span>}
                  </span>
                )}
              </div>
            </div>

            <div class="entry-media">
              <PhotoCarousel images={nota.data.images} title={nota.data.title} base={base} href={href} />
            </div>
          </div>

          {paragraphs.length > 0 && (
            <div class="entry-side">
              <div class="entry-columns" data-newspaper-cols tabindex="0" role="region" aria-label={`Texto de ${leadTitle || 'la publicación'}`}>
                {leadTitle && (
                  <h2 class="entry-title"><a href={href} class="entry-text-link">{leadTitle}</a></h2>
                )}
                {bodyParagraphs.map((p) => (
                  <p><a href={href} class="entry-text-link">{p}</a></p>
                ))}
              </div>
            </div>
          )}
        </li>
      );
    })}
  </ul>

  {notas.length === 0 && <p class="empty">Todavía no hay publicaciones.</p>}

  <Pagination
    prev={page.url.prev || undefined}
    next={page.url.next || undefined}
    current={page.currentPage}
    total={page.lastPage}
  />
</Base>

<script>
  function syncNewspaperColumns() {
    const isRows = document.documentElement.getAttribute('data-layout') === 'rows';
    const entries = document.querySelectorAll<HTMLElement>('.feed .entry');

    entries.forEach((entry) => {
      const colsEl = entry.querySelector<HTMLElement>('[data-newspaper-cols]');
      const mediaEl = entry.querySelector<HTMLElement>('.entry-media img, .entry-media');
      if (!colsEl) return;

      if (!isRows || window.innerWidth <= 832) {
        colsEl.style.height = '';
        colsEl.style.maxHeight = '';
        colsEl.classList.remove('is-multicol');
        return;
      }

      // Medimos la altura de la imagen para que las columnas tipo periódico no superen su alto
      const mediaRect = mediaEl ? mediaEl.getBoundingClientRect() : null;
      const targetH = mediaRect && mediaRect.height > 120 ? Math.round(mediaRect.height) : 360;

      // Primero dejamos altura automática en 1 columna para medir cuánto ocupa el texto verticalmente
      colsEl.classList.remove('is-multicol');
      colsEl.style.height = 'auto';
      colsEl.style.maxHeight = 'none';
      const naturalH = colsEl.scrollHeight;

      if (naturalH > targetH) {
        colsEl.style.height = `${targetH}px`;
        colsEl.style.maxHeight = `${targetH}px`;
        colsEl.classList.add('is-multicol');
      } else {
        colsEl.style.height = 'auto';
        colsEl.style.maxHeight = `${targetH}px`;
      }
    });
  }

  // En los contenedores de texto con scroll horizontal, la rueda vertical también desplaza en horizontal
  function setupHorizontalWheelScroll() {
    document.querySelectorAll<HTMLElement>('[data-newspaper-cols]').forEach((el) => {
      if (el.dataset.wheelBound === 'true') return;
      el.dataset.wheelBound = 'true';

      el.addEventListener(
        'wheel',
        (e: WheelEvent) => {
          if (document.documentElement.getAttribute('data-layout') !== 'rows') return;
          const maxScrollLeft = el.scrollWidth - el.clientWidth;
          if (maxScrollLeft <= 2) return;

          // Si el usuario mueve la rueda en vertical (sin que predomine ya el deltaX), desplazamos en horizontal
          if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
            const atStart = el.scrollLeft <= 0 && e.deltaY < 0;
            const atEnd = el.scrollLeft >= maxScrollLeft - 1 && e.deltaY > 0;
            if (!atStart && !atEnd) {
              e.preventDefault();
              el.scrollLeft += e.deltaY;
            }
          }
        },
        { passive: false }
      );
    });
  }

  function initRowsView() {
    setupHorizontalWheelScroll();
    syncNewspaperColumns();

    document.querySelectorAll<HTMLImageElement>('.entry-media img').forEach((img) => {
      if (!img.complete) {
        img.addEventListener('load', syncNewspaperColumns, { once: true });
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRowsView);
  } else {
    initRowsView();
  }

  window.addEventListener('resize', syncNewspaperColumns);

  const layoutObs = new MutationObserver(() => {
    requestAnimationFrame(() => {
      syncNewspaperColumns();
      setTimeout(syncNewspaperColumns, 60);
    });
  });
  layoutObs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-layout', 'data-size'] });
</script>

<style>
  /* ── Vista 1: Cuadrícula (Grid) por defecto ────────────────────────────── */
  .feed {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    width: 100%;
    column-count: 4;
    column-gap: 1.75rem;
  }

  :global([data-size="sm"]) .feed {
    column-count: 5;
    column-gap: 1.35rem;
  }

  :global([data-size="lg"]) .feed {
    column-count: 3;
    column-gap: 2.25rem;
  }

  @media (max-width: 60rem) {
    .feed,
    :global([data-size="sm"]) .feed,
    :global([data-size="lg"]) .feed {
      column-count: 3;
      column-gap: 1.5rem;
    }
  }

  @media (max-width: 44rem) {
    .feed,
    :global([data-size="sm"]) .feed,
    :global([data-size="lg"]) .feed {
      column-count: 2;
      column-gap: 1.25rem;
    }
  }

  @media (max-width: 28rem) {
    .feed,
    :global([data-size="sm"]) .feed,
    :global([data-size="lg"]) .feed {
      column-count: 1;
    }
  }

  .entry {
    break-inside: avoid;
    margin-bottom: 1.75rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    border: none;
    background: transparent;
  }

  .entry-left {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .entry-media {
    width: 100%;
    display: flex;
    justify-content: center;
    background: transparent;
    border: none;
    border-radius: 0;
  }

  /* En vista Grid tanto el texto lateral como los metadatos de hover permanecen ocultos */
  .entry-side,
  .meta {
    display: none;
  }

  /* ── Metadatos en Hover para la vista en fila (estilo Gaite: http://localhost:4324/) ── */
  .meta {
    font-family: var(--sans);
    font-size: 0.72rem;
    line-height: 1.3;
    color: var(--fg-muted);
    align-items: center;
    gap: 0.3rem 0.75rem;
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
  }

  .meta--hover {
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .entry:hover .meta--hover,
  .entry:focus-within .meta--hover {
    opacity: 1;
  }

  @media (hover: none) {
    .entry .meta--hover {
      opacity: 1;
    }
  }

  .meta-date,
  .meta-stats,
  .engagement,
  .metric-item {
    display: inline-flex;
    align-items: center;
  }

  .meta-date {
    gap: 0.32rem;
  }

  .meta-stats,
  .engagement {
    gap: 0.65rem;
  }

  .metric-item {
    gap: 0.25rem;
  }

  .meta :global(svg.icon) {
    flex-shrink: 0;
    color: var(--fg-muted);
    stroke-width: 1.75;
  }

  /* ── Vista 2: Filas (Rows) — El centro es la división entre imagen y texto ─ */
  :global([data-layout="rows"]) .feed {
    column-count: 1;
    display: flex;
    flex-direction: column;
    gap: 5.5rem;
    max-width: 86rem;
    margin: 0 auto;
    padding: 0.5rem 0 2rem;
  }

  :global([data-layout="rows"][data-size="sm"]) .feed {
    gap: 4.25rem;
  }

  :global([data-layout="rows"][data-size="lg"]) .feed {
    gap: 6.5rem;
    max-width: 92rem;
  }

  :global([data-layout="rows"]) .entry {
    margin-bottom: 0;
    display: grid;
    /* Dos mitades simétricas: el centro (50%) es exactamente la frontera entre imagen y texto */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    column-gap: 3rem;
    width: 100%;
  }

  :global([data-layout="rows"]) .entry-left {
    grid-column: 1;
    justify-self: end;
    width: 100%;
    max-width: 22rem;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  :global([data-layout="rows"][data-size="sm"]) .entry-left {
    max-width: 16rem;
  }

  :global([data-layout="rows"][data-size="lg"]) .entry-left {
    max-width: 29rem;
  }

  /* En vista Filas, los metadatos flotan a la izquierda de la imagen (igual que en http://localhost:4324/) */
  :global([data-layout="rows"]) .entry .meta {
    display: flex;
    position: absolute;
    right: calc(100% + 1.25rem);
    top: 0.15rem;
    width: max-content;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0.28rem;
  }

  :global([data-layout="rows"]) .entry-media {
    width: 100%;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  :global([data-layout="rows"]) .entry-media :global(.media-frame img) {
    max-height: 64vh;
    width: auto;
    max-width: 100%;
    display: block;
  }

  :global([data-layout="rows"][data-size="sm"]) .entry-media :global(.media-frame img) {
    max-height: 44vh;
  }

  :global([data-layout="rows"][data-size="lg"]) .entry-media :global(.media-frame img) {
    max-height: 80vh;
  }

  :global([data-layout="rows"]) .entry-side {
    grid-column: 2;
    justify-self: start;
    align-self: center;
    display: block;
    width: 100%;
    min-width: 0;
    color: var(--fg-secondary);
    transition: color 0.15s ease;
  }

  :global([data-layout="rows"]) .entry:hover .entry-side {
    color: var(--fg);
  }

  /* Columnas en horizontal estilo periódico con scroll horizontal */
  .entry-columns {
    font-family: var(--sans);
    font-size: 0.78rem;
    line-height: 1.65;
    color: inherit;
    text-align: left;
    max-width: 16.5rem;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
    padding-bottom: 0.25rem;
  }

  .entry-columns.is-multicol {
    max-width: 100%;
    column-width: 15.5rem;
    column-gap: 2rem;
    column-fill: auto;
  }

  .entry-columns::-webkit-scrollbar {
    height: 4px;
  }

  .entry-columns::-webkit-scrollbar-track {
    background: transparent;
  }

  .entry-columns::-webkit-scrollbar-thumb {
    background: var(--line-strong);
    border-radius: 9999px;
  }

  .entry-title {
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--fg);
    margin: 0 0 0.65em;
  }

  .entry-columns p {
    margin: 0 0 0.85em;
  }

  .entry-columns p:last-child {
    margin-bottom: 0;
  }

  .entry-text-link {
    color: inherit;
    text-decoration: none;
  }

  /* Responsivo para móvil/tablet estrecha */
  @media (max-width: 52rem) {
    :global([data-layout="rows"]) .feed {
      gap: 3.75rem;
    }
    :global([data-layout="rows"]) .entry {
      grid-template-columns: 1fr;
      row-gap: 1rem;
      max-width: 26rem;
      margin: 0 auto;
    }
    :global([data-layout="rows"]) .entry-left {
      grid-column: 1;
      justify-self: center;
      width: 100%;
      max-width: 100%;
      flex-direction: column;
    }
    :global([data-layout="rows"]) .entry .meta {
      position: static;
      order: 2;
      width: 100%;
      flex-direction: row;
      justify-content: space-between;
      gap: 0.75rem;
      margin-top: 0.45rem;
    }
    :global([data-layout="rows"]) .entry-side {
      grid-column: 1;
      width: 100%;
    }
    .entry-columns,
    .entry-columns.is-multicol {
      max-width: 100%;
      column-width: auto;
      column-count: 1;
      height: auto !important;
      max-height: none !important;
      overflow-x: visible;
    }
  }

  .empty {
    color: var(--fg-muted);
    text-align: center;
    padding: 4rem 0;
    font-size: 0.95rem;
  }
</style>

